# CareFlow AI Engine - Environment Variables
PORT=5000
NODE_ENV=development

# Google Maps API Key (get from https://console.cloud.google.com)
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Backend API Base URL (your backend engineer's server)
BACKEND_API_URL=http://localhost:4000

# AI Engine Secret (shared with other services)
AI_ENGINE_SECRET=careflow_ai_secret_2024

# Cache TTL in seconds
CACHE_TTL=60
